# Copy file này thành .env rồi điền giá trị thật, KHÔNG commit .env lên git

# Tier 3 - Qwen chạy bằng vLLM NGOÀI Docker (bạn tự cài/chạy trên máy host)
# "host.docker.internal" là cách container gọi ra được máy host của bạn
# Ví dụ nếu vLLM bạn serve ở host cổng 8000: http://host.docker.internal:8000/v1/chat/completions
QWEN_API_URL=http://host.docker.internal:8000/v1/chat/completions
QWEN_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# vLLM tự chạy local nên không cần key thật, nhưng client vẫn gửi header Authorization -> điền giá trị bất kỳ
QWEN_API_KEY=not-needed

# Có thể thêm các biến khác mà api/main.py hoặc image_service/clip_service.py cần
